# Nexus ERP Environment Configuration
# For local development, leave DATABASE_URL as SQLite
# For production PostgreSQL: postgresql://user:password@host:5432/nexus_erp

DATABASE_URL=sqlite:///nexus.db

# Optional: Add your Google Gemini API key to power the AI Agent
# Get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# App Settings
APP_NAME=Nexus ERP
SECRET_KEY=nexus-secret-change-in-production
